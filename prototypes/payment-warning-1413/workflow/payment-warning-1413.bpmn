      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Simon" bpmnElement="Lane_Simon" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#bac3d0">
        <dc:Bounds x="90" y="490" width="1660" height="350" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start" bpmnElement="Start" bioc:fill="#ffffff" bioc:stroke="#42536a">
        <dc:Bounds x="140" y="272" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="115" y="319" width="90" height="45" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
