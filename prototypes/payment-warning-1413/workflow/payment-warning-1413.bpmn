<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1413" targetNamespace="https://simon.example/workflows/ticket-1413" exporter="Simon ticket 1413 workflow draft" exporterVersion="1.0">
  <bpmn:process id="Process_1413" name="Payment name warning — payroll Step 2" isExecutable="false">
    <bpmn:documentation>Review draft based on the approved ticket 1413 proposal and UI. Actor: BC/President. Trigger: Approve Payroll in Step 2. Existing payroll approval validation, permissions, failures, and other workflow steps are outside this enhancement. Warning wording remains subject to Vy review.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_1413">
      <bpmn:lane id="Lane_BC" name="BC / President">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Read</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Choice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Return</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Simon" name="Simon">
        <bpmn:flowNodeRef>Check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Match</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Warning</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Highlight</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Existing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Review payroll&#10;Step 2">
      <bpmn:outgoing>F_Start</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Approve" name="Click Approve Payroll">
      <bpmn:incoming>F_Start</bpmn:incoming>
      <bpmn:incoming>F_Retry</bpmn:incoming>
      <bpmn:outgoing>F_Check</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Check" name="Check payment names&#10;against operator full name">
      <bpmn:documentation>Cheques: use Name on cheque. E-transfers: use Client name stored on the payment, not job Client name. Compare to payroll operator full name after trimming, collapsing extra whitespace, and ignoring capitalization. Exact full-name comparison only. Amount is not a matching condition.</bpmn:documentation>
      <bpmn:incoming>F_Check</bpmn:incoming>
      <bpmn:outgoing>F_Match</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Match" name="Any payment name&#10;matches operator?" default="F_No">
      <bpmn:incoming>F_Match</bpmn:incoming>
      <bpmn:outgoing>F_Yes</bpmn:outgoing>
      <bpmn:outgoing>F_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Warning" name="Show non-blocking&#10;payment-name warning">
      <bpmn:incoming>F_Yes</bpmn:incoming>
      <bpmn:outgoing>F_Show</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Read" name="Select a warning&#10;action">
      <bpmn:incoming>F_Show</bpmn:incoming>
      <bpmn:outgoing>F_Action</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Choice" name="Reviewer action?">
      <bpmn:incoming>F_Action</bpmn:incoming>
      <bpmn:outgoing>F_Review</bpmn:outgoing>
      <bpmn:outgoing>F_Acknowledge</bpmn:outgoing>
      <bpmn:outgoing>F_Dismiss</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Highlight" name="Scroll to first match;&#10;highlight all matching rows">
      <bpmn:incoming>F_Review</bpmn:incoming>
      <bpmn:outgoing>F_Retry</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Return" name="Return to payroll;&#10;no approval submitted">
      <bpmn:incoming>F_Dismiss</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Existing" name="Continue existing&#10;payroll approval process">
      <bpmn:documentation>Handoff to the existing approval process. Existing checks and outcomes are unchanged and not expanded in this enhancement diagram. This task does not mean payroll is automatically approved.</bpmn:documentation>
      <bpmn:incoming>F_No</bpmn:incoming>
      <bpmn:incoming>F_Acknowledge</bpmn:incoming>
      <bpmn:outgoing>F_End</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End" name="Existing approval&#10;process continues">
      <bpmn:incoming>F_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_Start" sourceRef="Start" targetRef="Approve" />
    <bpmn:sequenceFlow id="F_Check" sourceRef="Approve" targetRef="Check" />
    <bpmn:sequenceFlow id="F_Match" sourceRef="Check" targetRef="Match" />
    <bpmn:sequenceFlow id="F_Yes" sourceRef="Match" targetRef="Warning" name="Yes">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">oneOrMorePaymentNamesMatchOperator</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_No" sourceRef="Match" targetRef="Existing" name="No" />
    <bpmn:sequenceFlow id="F_Show" sourceRef="Warning" targetRef="Read" />
    <bpmn:sequenceFlow id="F_Action" sourceRef="Read" targetRef="Choice" />
    <bpmn:sequenceFlow id="F_Review" sourceRef="Choice" targetRef="Highlight" name="Review payments">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">reviewerAction == 'reviewPayments'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_Retry" sourceRef="Highlight" targetRef="Approve" name="Click Approve Payroll again after review" />
    <bpmn:sequenceFlow id="F_Acknowledge" sourceRef="Choice" targetRef="Existing" name="Acknowledge and approve">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">reviewerAction == 'acknowledgeAndApprove'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_Dismiss" sourceRef="Choice" targetRef="Return" name="Close / Escape">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">reviewerAction == 'dismissWarning'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_End" sourceRef="Existing" targetRef="End" />
    <bpmn:textAnnotation id="Matching_Rule">
      <bpmn:text>MATCHING RULE
Cheque: Name on cheque. E-transfer: Client name from the payment.
Compare with the payroll operator’s full name. Ignore capitalization and extra spaces; require an exact full-name match. The job’s Client name is not used.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Scope_Note">
      <bpmn:text>APPROVAL BEHAVIOR
The warning does not block approval or require payment correction.
No match: continue the existing approval process. Review: return to the matching rows. Acknowledgment: continue approval. Closing the warning does not submit approval.</bpmn:text>
    </bpmn:textAnnotation>
  </bpmn:process>
  <bpmn:collaboration id="Collaboration_1413">
    <bpmn:participant id="Participant_1413" name="Ticket 1413 · Payment warning · Payroll Step 2" processRef="Process_1413" />
  </bpmn:collaboration>
  <bpmndi:BPMNDiagram id="Diagram_1413">
    <bpmndi:BPMNPlane id="Plane_1413" bpmnElement="Collaboration_1413">
      <bpmndi:BPMNShape id="Shape_Participant_1413" bpmnElement="Participant_1413" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#8a97a9">
        <dc:Bounds x="60" y="180" width="1690" height="660" />
      </bpmndi:BPMNShape>
